            "widget": "spin",
            "min": 1,
            "max": 60
        },
        {
            "key": "show-in-calendar",
            "label": "Show Due Tasks in Calendar",
            "subtitle": "Open tasks with a due date appear in the Tasks calendar",
            "type": "boolean",
            "widget": "toggle"
        }
    ]
}
